<mxfile host="app.diagrams.net" agent="Kiro" version="24.0.0" type="device">
  <diagram id="tcs2iot-pipeline" name="TCS2IoT Pipeline">
    <mxGraphModel dx="1400" dy="820" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="820" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Title -->
        <mxCell id="title" value="TCS2IoT — Tail de log → decodificación JSON → publicación MQTT (TLS) a AWS IoT Core" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=18;fontStyle=1;fontColor=#232F3E;" vertex="1" parent="1">
          <mxGeometry x="120" y="20" width="1160" height="40" as="geometry" />
        </mxCell>

        <!-- ============ Device / Edge boundary ============ -->
        <mxCell id="edgeGroup" value="Dispositivo / Edge (contenedor Docker)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F2F3F3;strokeColor=#7D8998;dashed=1;verticalAlign=top;fontSize=13;fontStyle=1;fontColor=#5A6C86;arcSize=3;" vertex="1" parent="1">
          <mxGeometry x="80" y="100" width="760" height="560" as="geometry" />
        </mxCell>

        <!-- Log file source -->
        <mxCell id="logfile" value="Archivo de log&#10;(captura TCS-GPS)&#10;— líneas se agregan al final —" style="shape=note;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=12;verticalAlign=middle;align=center;size=18;" vertex="1" parent="1">
          <mxGeometry x="120" y="180" width="180" height="120" as="geometry" />
        </mxCell>

        <!-- Python process box -->
        <mxCell id="pyproc" value="Proceso Python (processor.py)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F0FE;strokeColor=#3B78E7;verticalAlign=top;fontSize=13;fontStyle=1;fontColor=#1A56C4;arcSize=6;" vertex="1" parent="1">
          <mxGeometry x="360" y="150" width="440" height="470" as="geometry" />
        </mxCell>

        <!-- Step 1: tail / follow -->
        <mxCell id="step1" value="1. Tail del archivo&#10;follow() — seek al final,&#10;lee cada línea nueva (poll)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=12;verticalAlign=middle;align=center;" vertex="1" parent="1">
          <mxGeometry x="390" y="200" width="180" height="90" as="geometry" />
        </mxCell>

        <!-- Step 2: parse to JSON -->
        <mxCell id="step2" value="2. Decodificar línea&#10;parser.parse_to_json()&#10;línea CSV → documento JSON" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=12;verticalAlign=middle;align=center;" vertex="1" parent="1">
          <mxGeometry x="390" y="330" width="180" height="90" as="geometry" />
        </mxCell>

        <!-- JSON doc -->
        <mxCell id="jsondoc" value="{&#10;  &quot;date&quot;: ...,&#10;  &quot;tetra&quot;: ...,&#10;  &quot;message&quot;: ...,&#10;  &quot;coordenadas&quot;: {&#10;    &quot;lat&quot;: ..., &quot;long&quot;: ...&#10;  }, ...&#10;}" style="shape=note;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=10;align=left;verticalAlign=middle;size=14;fontFamily=Courier New;" vertex="1" parent="1">
          <mxGeometry x="620" y="315" width="150" height="120" as="geometry" />
        </mxCell>

        <!-- Step 3: publish -->
        <mxCell id="step3" value="3. Publicar&#10;iot_publisher.Publisher.publish()&#10;MQTT sobre TLS (mTLS X.509)&#10;topic: tcs/gps  ·  QoS 1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=12;verticalAlign=middle;align=center;" vertex="1" parent="1">
          <mxGeometry x="390" y="460" width="180" height="100" as="geometry" />
        </mxCell>

        <!-- Certs -->
        <mxCell id="certs" value="Certificados X.509&#10;device.pem.crt&#10;private.pem.key&#10;AmazonRootCA1.pem" style="shape=mxgraph.aws4.certificate_manager;sketch=0;html=1;dashed=0;whiteSpace=wrap;fillColor=#DD344C;strokeColor=none;verticalLabelPosition=bottom;verticalAlign=top;aspect=fixed;pointerEvents=1;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="640" y="470" width="78" height="78" as="geometry" />
        </mxCell>

        <!-- ============ AWS Cloud boundary ============ -->
        <mxCell id="awsCloud" value="AWS Cloud" style="points=[[0,0],[0.25,0],[0.5,0],[0.75,0],[1,0],[1,0.25],[1,0.5],[1,0.75],[1,1],[0.75,1],[0.5,1],[0.25,1],[0,1],[0,0.75],[0,0.5],[0,0.25]];outlineConnect=0;gradientColor=none;html=1;whiteSpace=wrap;fontSize=12;fontStyle=0;container=1;pointerEvents=0;collapsible=0;recursiveResize=0;shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.group_aws_cloud_alt;strokeColor=#232F3E;fillColor=none;verticalAlign=top;align=left;spacingLeft=30;fontColor=#232F3E;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="920" y="150" width="400" height="440" as="geometry" />
        </mxCell>

        <!-- IoT Core -->
        <mxCell id="iotcore" value="AWS IoT Core&#10;(Message Broker)" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;gradientColor=#4D72F3;gradientDirection=north;fillColor=#3334B9;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.iot_core;" vertex="1" parent="1">
          <mxGeometry x="1010" y="250" width="78" height="78" as="geometry" />
        </mxCell>

        <!-- Downstream rules engine (informative) -->
        <mxCell id="rules" value="IoT Rules&#10;(enrutamiento a otros servicios)" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;gradientColor=#4D72F3;gradientDirection=north;fillColor=#3334B9;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.rule;" vertex="1" parent="1">
          <mxGeometry x="1010" y="430" width="78" height="78" as="geometry" />
        </mxCell>

        <!-- ============ Edges ============ -->
        <!-- logfile -> step1 -->
        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#6C8EBF;strokeWidth=2;endArrow=block;fontSize=11;" edge="1" parent="1" source="logfile" target="step1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e1lbl" value="líneas nuevas" style="edgeLabel;html=1;align=center;verticalAlign=middle;fontSize=11;fontColor=#5A6C86;" connectable="0" vertex="1" parent="e1">
          <mxGeometry x="-0.1" relative="1" as="geometry" />
        </mxCell>

        <!-- step1 -> step2 -->
        <mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#6C8EBF;strokeWidth=2;endArrow=block;fontSize=11;" edge="1" parent="1" source="step1" target="step2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e2lbl" value="línea CSV cruda" style="edgeLabel;html=1;align=center;verticalAlign=middle;fontSize=11;fontColor=#5A6C86;" connectable="0" vertex="1" parent="e2">
          <mxGeometry x="-0.1" relative="1" as="geometry" />
        </mxCell>

        <!-- step2 -> jsondoc -->
        <mxCell id="e3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#82B366;strokeWidth=2;endArrow=block;fontSize=11;" edge="1" parent="1" source="step2" target="jsondoc">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- jsondoc -> step3 -->
        <mxCell id="e4" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#82B366;strokeWidth=2;endArrow=block;fontSize=11;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=1;entryY=0.25;entryDx=0;entryDy=0;" edge="1" parent="1" source="jsondoc" target="step3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e4lbl" value="payload JSON" style="edgeLabel;html=1;align=center;verticalAlign=middle;fontSize=11;fontColor=#5A6C86;" connectable="0" vertex="1" parent="e4">
          <mxGeometry x="-0.1" relative="1" as="geometry" />
        </mxCell>

        <!-- certs -> step3 (auth) -->
        <mxCell id="e5" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#DD344C;strokeWidth=2;endArrow=block;dashed=1;fontSize=11;" edge="1" parent="1" source="certs" target="step3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e5lbl" value="autenticación mTLS" style="edgeLabel;html=1;align=center;verticalAlign=middle;fontSize=11;fontColor=#DD344C;" connectable="0" vertex="1" parent="e5">
          <mxGeometry x="-0.1" relative="1" as="geometry" />
        </mxCell>

        <!-- step3 -> IoT Core (MQTT/TLS) -->
        <mxCell id="e6" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#232F3E;strokeWidth=3;endArrow=block;fontSize=12;fontStyle=1;" edge="1" parent="1" source="step3" target="iotcore">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e6lbl" value="MQTT sobre TLS (8883)&#10;publish topic tcs/gps" style="edgeLabel;html=1;align=center;verticalAlign=middle;fontSize=11;fontColor=#232F3E;fontStyle=1;" connectable="0" vertex="1" parent="e6">
          <mxGeometry x="-0.05" relative="1" as="geometry" />
        </mxCell>

        <!-- IoT Core -> Rules -->
        <mxCell id="e7" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#232F3E;strokeWidth=2;endArrow=block;dashed=1;fontSize=11;" edge="1" parent="1" source="iotcore" target="rules">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
